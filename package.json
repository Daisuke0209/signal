{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "uv run --directory backend uvicorn signal_api.main:app --reload --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:api": "uv run --directory backend ruff check .",
    "format:api:check": "uv run --directory backend ruff format --check .",
    "typecheck:api": "uv run --directory backend mypy src tests",
    "test:api": "uv run --directory backend pytest tests",
    "test:integration": "uv run --directory backend pytest tests/integration",
    "db:migrate": "uv run --directory backend alembic -c alembic.ini upgrade head",
    "db:check-schema": "uv run --directory backend alembic -c alembic.ini check",
    "db:check": "uv run --directory backend python -m signal_api.check_db",
    "db:seed": "uv run --directory backend python -m signal_api.seed"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^27.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
